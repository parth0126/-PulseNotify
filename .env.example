# Copy to .env and replace the placeholder values. Never commit .env.
# manage.py and Celery default to config.settings.local; export
# DJANGO_SETTINGS_MODULE=config.settings.production in the shell to override.

DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (also read by docker-compose.yml)
POSTGRES_DB=pulsenotify
POSTGRES_USER=pulsenotify
POSTGRES_PASSWORD=replace-with-a-db-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis / Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Base URL the check_prices task uses to call the mock price endpoint
INTERNAL_API_BASE_URL=http://127.0.0.1:8000
PRICE_API_TIMEOUT_SECONDS=5

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
