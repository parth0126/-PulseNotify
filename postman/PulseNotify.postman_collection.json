{
  "info": {
    "name": "PulseNotify",
    "description": "Covers the 13 PulseNotify API scenarios. Run in order with the Collection Runner.\n\nBefore request 12a, create an admin (see README) and set the collection variables admin_username and admin_password locally. Test users and passwords are generated at run time.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Register new user (201)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"username\", \"user_\" + Date.now());",
              "pm.collectionVariables.set(\"password\", \"Pw-\" + Math.random().toString(36).slice(2) + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "{",
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "const data = pm.response.json();",
              "pm.test(\"Role is user\", () => pm.expect(data.role).to.eql(\"user\"));",
              "pm.test(\"Access token returned\", () => pm.expect(data.access).to.be.a(\"string\"));",
              "pm.collectionVariables.set(\"access_token\", data.access);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/register/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "register",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"email\": \"{{username}}@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
