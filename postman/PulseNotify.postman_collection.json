    {
      "name": "09 Flight price valid route, no auth (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "{",
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test(\"Route echoed\", () => pm.expect(data.route).to.eql(\"DEL-BOM\"));",
              "pm.test(\"Price in range\", () => pm.expect(data.price).to.be.within(3000, 7000));",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/flights/price/?route=DEL-BOM",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "flights",
            "price",
            ""
          ],
          "query": [
            {
              "key": "route",
              "value": "DEL-BOM"
            }
          ]
        }
      }
    },
