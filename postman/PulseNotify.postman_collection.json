    {
      "name": "05 Create alert (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "{",
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "const data = pm.response.json();",
              "pm.test(\"Alert is active\", () => pm.expect(data.status).to.eql(\"active\"));",
              "pm.test(\"Route is DEL-BOM\", () => pm.expect(data.route).to.eql(\"DEL-BOM\"));",
              "pm.collectionVariables.set(\"alert_id\", data.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/alerts/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "alerts",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"origin\": \"DEL\",\n  \"destination\": \"BOM\",\n  \"threshold_price\": \"5000.00\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "06 List own alerts (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "{",
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test(\"Response is a list\", () => pm.expect(data).to.be.an(\"array\"));",
              "pm.test(\"Contains only this user's alert\", () => {",
              "    pm.expect(data.map(a => a.id)).to.eql([Number(pm.collectionVariables.get(\"alert_id\"))]);",
              "});",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/alerts/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "alerts",
            ""
          ]
