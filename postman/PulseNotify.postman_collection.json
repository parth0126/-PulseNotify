    {
      "name": "12 Admin summary as admin (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "{",
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test(\"Has summary keys\", () => pm.expect(data).to.include.keys(\"total_alerts\", \"active_alerts\", \"triggered_alerts\", \"total_notifications\", \"top_routes\"));",
              "pm.test(\"At most 5 top routes\", () => pm.expect(data.top_routes.length).to.be.at.most(5));",
              "}"
            ]
          }
        }
